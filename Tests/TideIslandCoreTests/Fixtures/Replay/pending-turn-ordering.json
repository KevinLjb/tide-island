            "cwd": "/fixture/projects/tide-island",
            "hook_event_name": "UserPromptSubmit",
            "model": "fixture-model",
            "permission_mode": "default",
            "prompt": "fixture-private-prompt"
          },
          "expect": {
            "disposition": "applied",
            "sessions": [
              {
                "id": "session-pending-order",
                "projectName": "tide-island",
                "phase": "working",
                "updatedAt": "2026-11-16T00:00:02.000Z",
                "lastEventID": "3D1C8ED3-5875-53A8-BDAA-CD748597B3AD",
                "context": {
                  "source": "codexHook",
                  "kind": "turnStarted",
                  "receivedAt": "2026-11-16T00:00:02.000Z",
                  "turnID": "turn-new"
