{
  "schemaVersion": 1,
  "description": "Intentionally fails until T006 implements cross-turn ordering. This is a diagnostic reproduction, not a passing product acceptance case.",
  "scenarios": [
    {
      "name": "late-previous-turn-notify",
      "description": "Desired T006 behavior: a late completion from the previous turn must not replace the current working turn.",
      "steps": [
        {
          "id": "94686A90-EDDF-5FB7-86C6-F3A9F50FD3B7",
          "at": "2026-11-16T00:00:01.000Z",
          "source": "hook",
          "payload": {
            "session_id": "session-pending-order",
            "turn_id": "turn-old",
            "transcript_path": "/fixture-private/transcript.jsonl",
            "cwd": "/fixture/projects/tide-island",
            "hook_event_name": "UserPromptSubmit",
            "model": "fixture-model",
            "permission_mode": "default",
            "prompt": "fixture-private-prompt"
          },
          "expect": {
            "disposition": "applied",
            "sessions": [
              {
                "id": "session-pending-order",
                "projectName": "tide-island",
                "phase": "working",
                "updatedAt": "2026-11-16T00:00:01.000Z",
                "lastEventID": "94686A90-EDDF-5FB7-86C6-F3A9F50FD3B7",
                "context": {
                  "source": "codexHook",
                  "kind": "turnStarted",
                  "receivedAt": "2026-11-16T00:00:01.000Z",
                  "turnID": "turn-old"
                }
              }
            ]
          }
        },
        {
          "id": "3D1C8ED3-5875-53A8-BDAA-CD748597B3AD",
