        },
        {
          "id": "0A506F3F-0C45-5989-B02E-A32E86963C68",
          "at": "2026-11-16T00:00:03.000Z",
          "source": "notify",
          "payload": {
            "type": "agent-turn-complete",
            "thread-id": "session-pending-order",
            "turn-id": "turn-old",
            "cwd": "/fixture/projects/tide-island",
            "input-messages": [
              "fixture-private-prompt"
